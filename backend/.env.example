# Required — Anthropic API key for Claude summarization
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional — NewsAPI.org key (omit to skip NewsAPI source)
NEWS_API_KEY=your-newsapi-key-here

# Database connection string (SQLite default; swap to PostgreSQL URI for production)
DATABASE_URL=sqlite:///./technew.db

# How often the scheduler fetches new articles (in hours)
FETCH_INTERVAL_HOURS=6

# Comma-separated RSS feed URLs to poll
RSS_FEED_URLS=https://feeds.arstechnica.com/arstechnica/technology-lab,https://hnrss.org/frontpage
